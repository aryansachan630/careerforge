{
  "name":"careerforge","private":true,"version":"2.0.0",
  "workspaces":["client","server"],
  "scripts":{
    "dev":"concurrently \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev":"npm --workspace server run dev",
    "client:dev":"npm --workspace client run dev",
    "build":"npm --workspace client run build",
    "start":"npm --workspace server start"
  },
  "devDependencies":{"concurrently":"^9.2.1"}
}